# =============================================================================
# interview-engine-service — environment variables
# Copy to .env and fill in your values.
# =============================================================================

# -- App ----------------------------------------------------------------------
APP_ENV=development
APP_NAME=interview-engine-service

# -- Database -----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=core_api
POSTGRES_PASSWORD=core_api_password
POSTGRES_DB=core_api_db

# -- Redis --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# -- Deepgram (STT + TTS) -----------------------------------------------------
# Get your key at: https://console.deepgram.com
DEEPGRAM_API_KEY=Deepgram_API_Key_Goes_Here
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-asteria-en

# -- Groq (LLM) ---------------------------------------------------------------
# Get your key at: https://console.groq.com
GROQ_API_KEY=Groq_API_Key_Goes_Here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=512
GROQ_TEMPERATURE=0.7
