# interview-engine-service environment variables

APP_ENV=development
APP_NAME=interview-engine-service

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=core_api
POSTGRES_PASSWORD=core_api_password
POSTGRES_DB=core_api_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

GROQ_API_KEY=
FALLBACK_GROQ_API_KEY=
GROQ_EVALUATION_API_KEY=
GROQ_QUESTION_API_KEY=
GROQ_QUESTION_MODEL=llama-3.1-8b-instant
GROQ_LIVE_EVAL_MODEL=llama-3.1-8b-instant
GROQ_CLASSIFY_MODEL=llama-3.1-8b-instant

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_TEMPERATURE=1.0
NVIDIA_NIM_TOP_P=0.95
NVIDIA_NIM_MAX_TOKENS=16384
NVIDIA_NIM_REASONING_BUDGET=16384
NVIDIA_NIM_TIMEOUT_SECS=600
NVIDIA_NIM_STREAM=true

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=interview-agent
