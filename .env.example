# interview-engine-service environment variables

APP_NAME=interview-engine-service

CORE_API_URL=http://localhost:8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=core_api
POSTGRES_PASSWORD=core_api_password
POSTGRES_DB=core_api_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
VAD_MIN_SPEECH_DURATION_SECS=0.2
VAD_MIN_SILENCE_DURATION_SECS=0.4
VAD_PREFIX_PADDING_DURATION_SECS=0.15
TURN_ENDPOINTING_MIN_DELAY_SECS=0.5
TURN_ENDPOINTING_MAX_DELAY_SECS=2.0
FALSE_INTERRUPTION_TIMEOUT_SECS=1.2
ENABLE_ACK_FILLER=true

# Common live-interview pool. Use keys from independently provisioned quota
# domains when you need real failover/isolation.
GROQ_INTERVIEW_API_KEY_1=
GROQ_INTERVIEW_API_KEY_2=
GROQ_INTERVIEW_API_KEY_3=
GROQ_INTERVIEW_API_KEY_4=

GROQ_QUESTION_MODEL=openai/gpt-oss-120b
GROQ_QUESTION_TIMEOUT_SECS=10
GROQ_INTERVIEWER_MODEL=openai/gpt-oss-120b
GROQ_INTERVIEWER_MAX_TOKENS=520
GROQ_INTERVIEWER_TEMPERATURE=0.28
GROQ_INTERVIEWER_TIMEOUT_SECS=12
GROQ_CLASSIFY_MODEL=openai/gpt-oss-20b
GROQ_CLASSIFY_MAX_TOKENS=128
GROQ_CLASSIFY_TEMPERATURE=0
GROQ_CLASSIFY_TIMEOUT_SECS=5
GROQ_REASONING_EFFORT=low

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_TEMPERATURE=0.2
NVIDIA_NIM_TOP_P=0.95
NVIDIA_NIM_MAX_TOKENS=16384
NVIDIA_NIM_REASONING_BUDGET=16384
NVIDIA_NIM_TIMEOUT_SECS=600
NVIDIA_NIM_STREAM=true

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=interview-agent
LIVEKIT_FORCE_RELAY=false
